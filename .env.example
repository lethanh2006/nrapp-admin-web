# URL gốc của NRApp Gateway. Không thêm dấu / ở cuối.
NRAPP_API_URL=https://api-vps.thanhlelmtp2006.id.vn/api

# Thời gian chờ mỗi request đến Gateway (1.000-60.000 ms).
NRAPP_API_TIMEOUT_MS=10000

# Tự động là true khi build production. Chỉ đặt false khi chạy HTTP cục bộ.
NRAPP_COOKIE_SECURE=false
